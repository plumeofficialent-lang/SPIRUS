<Window x:Class="Spirus.Setup.SetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Installation de SPIRUS" Width="600" Height="500" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen" Background="{StaticResource Bg}" Foreground="{StaticResource Text}"
        FontFamily="{StaticResource UiFont}" Icon="Assets/vigie.png" UseLayoutRounding="True">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40" ResizeBorderThickness="0" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>
    <Window.Resources>
        <Style x:Key="Bar" TargetType="ProgressBar">
            <Setter Property="Height" Value="6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid>
                            <Border x:Name="PART_Track" CornerRadius="3" Background="#1A1A1A"/>
                            <Border x:Name="PART_Indicator" CornerRadius="3" HorizontalAlignment="Left" Background="{StaticResource AccentGradient}"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="OptionRow" TargetType="Grid">
            <Setter Property="Margin" Value="0,7"/>
        </Style>
    </Window.Resources>

    <Border BorderBrush="{StaticResource Line}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition/>
            </Grid.RowDefinitions>
            <TextBlock x:Name="HeaderText" Text="INSTALLATION" Style="{StaticResource Text.Caption}" Margin="22,0,0,0" VerticalAlignment="Center"/>
            <Button x:Name="CloseButton" Style="{StaticResource Btn.Close}" Content="&#xE8BB;" HorizontalAlignment="Right"
                    WindowChrome.IsHitTestVisibleInChrome="True" Click="Cancel_Click" ToolTip="Fermer"/>

            <Grid Grid.Row="1" Margin="40,4,40,30">
                <!-- ======================================== Bienvenue -->
                <DockPanel x:Name="WelcomePanel">
                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Style="{StaticResource Btn.Secondary}" Content="Annuler" Click="Cancel_Click" Margin="0,0,10,0" MinWidth="110"/>
                        <Button x:Name="InstallButton" Style="{StaticResource Btn.Primary}" Click="Install_Click" MinWidth="150">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Text.Icon}" Text="&#xE896;" FontSize="14" Margin="0,0,9,0"/>
                                <TextBlock x:Name="InstallLabel" Text="Installer"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Image Source="Assets/vigie.png" Width="60" Height="60" RenderOptions.BitmapScalingMode="HighQuality">
                            </Image>
                            <StackPanel Margin="18,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="SPIRUS" FontFamily="{StaticResource DisplayFont}" FontSize="32" FontWeight="Bold"/>
                                <TextBlock x:Name="VersionText" Style="{StaticResource Text.Muted}" Margin="1,-2,0,0"/>
                            </StackPanel>
                        </StackPanel>
                        <TextBlock Style="{StaticResource Text.Muted}" FontSize="13.5" Margin="0,20,0,0"
                                   Text="Protection en temps réel, surveillance des programmes, bouclier anti-rançongiciel, contrôle des clés USB et analyses à la demande."/>
                        <Border Style="{StaticResource Card}" Margin="0,18,0,0" Padding="18,8">
                            <StackPanel>
                                <Grid Style="{StaticResource OptionRow}">
                                    <TextBlock Text="Démarrer avec Windows (recommandé)" VerticalAlignment="Center" FontSize="13.5"/>
                                    <CheckBox x:Name="OptAutostart" Style="{StaticResource Switch}" HorizontalAlignment="Right" IsChecked="True"/>
                                </Grid>
                                <Grid Style="{StaticResource OptionRow}">
                                    <TextBlock Text="Ajouter « Analyser avec SPIRUS » au clic droit" VerticalAlignment="Center" FontSize="13.5"/>
                                    <CheckBox x:Name="OptContextMenu" Style="{StaticResource Switch}" HorizontalAlignment="Right" IsChecked="True"/>
                                </Grid>
                                <Grid Style="{StaticResource OptionRow}">
                                    <TextBlock Text="Créer un raccourci sur le Bureau" VerticalAlignment="Center" FontSize="13.5"/>
                                    <CheckBox x:Name="OptDesktop" Style="{StaticResource Switch}" HorizontalAlignment="Right" IsChecked="True"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                        <TextBlock x:Name="LocationText" Style="{StaticResource Text.Caption}" FontWeight="Normal" Margin="2,14,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </DockPanel>

                <!-- ======================================== Désinstallation -->
                <DockPanel x:Name="UninstallPanel" Visibility="Collapsed">
                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Style="{StaticResource Btn.Secondary}" Content="Annuler" Click="Cancel_Click" Margin="0,0,10,0" MinWidth="110"/>
                        <Button Style="{StaticResource Btn.Danger}" Content="Désinstaller" Click="Uninstall_Click" MinWidth="150"/>
                    </StackPanel>
                    <StackPanel>
                        <Image Source="Assets/vigie.png" Width="60" Height="60" HorizontalAlignment="Left" Opacity="0.85" RenderOptions.BitmapScalingMode="HighQuality"/>
                        <TextBlock Text="Désinstaller SPIRUS" Style="{StaticResource Text.H1}" Margin="0,18,0,0"/>
                        <TextBlock Style="{StaticResource Text.Muted}" FontSize="13.5" Margin="0,8,0,0"
                                   Text="SPIRUS ne surveillera plus cet ordinateur. Microsoft Defender reste actif et continue de vous protéger."/>
                        <Border Style="{StaticResource Card}" Margin="0,22,0,0" Padding="18,8">
                            <Grid Style="{StaticResource OptionRow}">
                                <StackPanel Margin="0,0,60,0">
                                    <TextBlock Text="Supprimer aussi mes données" FontSize="13.5"/>
                                    <TextBlock Text="Réglages, journal et fichiers en quarantaine." Style="{StaticResource Text.Muted}" FontSize="12"/>
                                </StackPanel>
                                <CheckBox x:Name="OptRemoveData" Style="{StaticResource Switch}" HorizontalAlignment="Right"/>
                            </Grid>
                        </Border>
                    </StackPanel>
                </DockPanel>

                <!-- ======================================== Progression -->
                <StackPanel x:Name="ProgressPanel" VerticalAlignment="Center" Visibility="Collapsed">
                    <Image Source="Assets/vigie.png" Width="72" Height="72" RenderOptions.BitmapScalingMode="HighQuality">
                    </Image>
                    <TextBlock x:Name="ProgressTitle" Text="Installation en cours…" Style="{StaticResource Text.H2}" HorizontalAlignment="Center" Margin="0,22,0,0"/>
                    <ProgressBar x:Name="Bar" Style="{StaticResource Bar}" Maximum="100" Margin="30,22,30,0"/>
                    <TextBlock x:Name="StatusText" Style="{StaticResource Text.Muted}" HorizontalAlignment="Center" Margin="0,12,0,0"/>
                </StackPanel>

                <!-- ======================================== Terminé -->
                <DockPanel x:Name="DonePanel" Visibility="Collapsed">
                    <Button DockPanel.Dock="Bottom" Style="{StaticResource Btn.Primary}" Content="Terminer" Click="Finish_Click" HorizontalAlignment="Right" MinWidth="150"/>
                    <StackPanel VerticalAlignment="Center">
                        <Border Width="88" Height="88" CornerRadius="44" Background="{StaticResource AccentSoft}" BorderBrush="#2A2A2A" BorderThickness="1">
                            <TextBlock Style="{StaticResource Text.Icon}" Text="&#xE73E;" FontSize="38" HorizontalAlignment="Center"/>
                        </Border>
                        <TextBlock x:Name="DoneTitle" Text="SPIRUS est installé" Style="{StaticResource Text.H1}" HorizontalAlignment="Center" Margin="0,22,0,0"/>
                        <TextBlock x:Name="DoneText" Style="{StaticResource Text.Muted}" FontSize="13.5" TextAlignment="Center" HorizontalAlignment="Center" Margin="20,8,20,0"/>
                        <StackPanel x:Name="LaunchRow" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,22,0,0">
                            <CheckBox x:Name="OptLaunch" Style="{StaticResource Switch}" IsChecked="True"/>
                            <TextBlock Text="Ouvrir SPIRUS maintenant" VerticalAlignment="Center" Margin="12,0,0,0" FontSize="13.5"/>
                        </StackPanel>
                    </StackPanel>
                </DockPanel>

                <!-- ======================================== Erreur -->
                <DockPanel x:Name="ErrorPanel" Visibility="Collapsed">
                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Style="{StaticResource Btn.Secondary}" Content="Fermer" Click="Cancel_Click" Margin="0,0,10,0" MinWidth="110"/>
                        <Button Style="{StaticResource Btn.Primary}" Content="Réessayer" Click="Retry_Click" MinWidth="150"/>
                    </StackPanel>
                    <StackPanel VerticalAlignment="Center">
                        <Border Width="88" Height="88" CornerRadius="44" Background="{StaticResource DangerSoft}">
                            <TextBlock Style="{StaticResource Text.Icon}" Text="&#xE7BA;" FontSize="36" Foreground="{StaticResource Danger}" HorizontalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Un problème est survenu" Style="{StaticResource Text.H1}" HorizontalAlignment="Center" Margin="0,22,0,0"/>
                        <TextBlock x:Name="ErrorText" Style="{StaticResource Text.Muted}" FontSize="13.5" TextAlignment="Center" HorizontalAlignment="Center" Margin="20,8,20,0"/>
                    </StackPanel>
                </DockPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
