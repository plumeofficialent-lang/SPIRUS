<UserControl x:Class="Vigie.App.Pages.ProtectionPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
        <StackPanel Margin="36,4,36,32">
            <TextBlock Text="Protection" Style="{StaticResource Text.H1}"/>
            <TextBlock Text="Les boucliers de SPIRUS fonctionnent en permanence, même quand cette fenêtre est fermée." Style="{StaticResource Text.Muted}" FontSize="14" Margin="0,4,0,0"/>
            <StackPanel x:Name="Rows"/>

            <TextBlock Text="SENSIBILITÉ DES HEURISTIQUES" Style="{StaticResource Text.Caption}" Margin="4,22,0,10"/>
            <Border Style="{StaticResource Card}">
                <DockPanel>
                    <Border DockPanel.Dock="Right" CornerRadius="10" Background="{StaticResource Field}" BorderBrush="{StaticResource Line}" BorderThickness="1" Padding="4" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="SensLow" Style="{StaticResource Segment}" GroupName="sens" Content="Faible" Checked="Sensitivity_Checked"/>
                            <RadioButton x:Name="SensNormal" Style="{StaticResource Segment}" GroupName="sens" Content="Normale" Checked="Sensitivity_Checked"/>
                            <RadioButton x:Name="SensHigh" Style="{StaticResource Segment}" GroupName="sens" Content="Élevée" Checked="Sensitivity_Checked"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource IconBadge}" Background="{StaticResource InfoSoft}" VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource Text.Icon}" Text="&#xE9D9;" Foreground="{StaticResource Info}" HorizontalAlignment="Center"/>
                    </Border>
                    <StackPanel Margin="16,0,16,0" VerticalAlignment="Center">
                        <TextBlock Text="Niveau de détection" FontWeight="SemiBold" FontSize="14"/>
                        <TextBlock x:Name="SensDescription" Style="{StaticResource Text.Muted}" Margin="0,3,0,0"/>
                    </StackPanel>
                </DockPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
