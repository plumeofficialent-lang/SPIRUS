<UserControl x:Class="Vigie.App.Pages.JournalPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="36,4,36,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <DockPanel>
            <Button DockPanel.Dock="Right" Style="{StaticResource Btn.Secondary}" VerticalAlignment="Center" Click="Clear_Click">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource Text.Icon}" Text="&#xE74D;" FontSize="13" Margin="0,0,8,0"/>
                    <TextBlock Text="Effacer le journal"/>
                </StackPanel>
            </Button>
            <StackPanel>
                <TextBlock Text="Journal" Style="{StaticResource Text.H1}"/>
                <TextBlock Text="Tout ce que SPIRUS a vu, analysé et neutralisé." Style="{StaticResource Text.Muted}" FontSize="14" Margin="0,4,0,0"/>
            </StackPanel>
        </DockPanel>

        <Border Grid.Row="1" CornerRadius="10" Background="{StaticResource Field}" BorderBrush="{StaticResource Line}" BorderThickness="1" Padding="4" HorizontalAlignment="Left" Margin="0,20,0,14">
            <StackPanel Orientation="Horizontal">
                <RadioButton x:Name="FilterAll" Style="{StaticResource Segment}" GroupName="filter" Content="Tout" IsChecked="True" Checked="Filter_Checked"/>
                <RadioButton x:Name="FilterThreats" Style="{StaticResource Segment}" GroupName="filter" Content="Menaces" Checked="Filter_Checked"/>
                <RadioButton x:Name="FilterActions" Style="{StaticResource Segment}" GroupName="filter" Content="Actions" Checked="Filter_Checked"/>
                <RadioButton x:Name="FilterInfo" Style="{StaticResource Segment}" GroupName="filter" Content="Informations" Checked="Filter_Checked"/>
            </StackPanel>
        </Border>

        <ListBox x:Name="Entries" Grid.Row="2" Style="{StaticResource List.Plain}">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource Row}" Padding="14,11">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border x:Name="badge" Width="34" Height="34" CornerRadius="9" Background="{StaticResource InfoSoft}" VerticalAlignment="Center">
                                <TextBlock x:Name="glyph" Style="{StaticResource Text.Icon}" FontSize="14" Text="&#xE946;" Foreground="{StaticResource Info}" HorizontalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" Margin="14,0,12,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="13.5"/>
                                <TextBlock Text="{Binding Detail}" Style="{StaticResource Text.Muted}" FontSize="12" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding Detail}"/>
                            </StackPanel>
                            <TextBlock Grid.Column="2" Text="{Binding TimeText}" Style="{StaticResource Text.Caption}" FontWeight="Normal" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                    <DataTemplate.Triggers>
                        <DataTrigger Binding="{Binding Level}" Value="Success">
                            <Setter TargetName="badge" Property="Background" Value="{StaticResource AccentSoft}"/>
                            <Setter TargetName="glyph" Property="Foreground" Value="{StaticResource Accent}"/>
                            <Setter TargetName="glyph" Property="Text" Value="&#xE73E;"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Level}" Value="Warning">
                            <Setter TargetName="badge" Property="Background" Value="{StaticResource WarningSoft}"/>
                            <Setter TargetName="glyph" Property="Foreground" Value="{StaticResource Warning}"/>
                            <Setter TargetName="glyph" Property="Text" Value="&#xE7BA;"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Level}" Value="Threat">
                            <Setter TargetName="badge" Property="Background" Value="{StaticResource DangerSoft}"/>
                            <Setter TargetName="glyph" Property="Foreground" Value="{StaticResource Danger}"/>
                            <Setter TargetName="glyph" Property="Text" Value="&#xEA18;"/>
                        </DataTrigger>
                    </DataTemplate.Triggers>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <TextBlock x:Name="Empty" Grid.Row="2" Text="Le journal est vide." Style="{StaticResource Text.Muted}" FontSize="14" HorizontalAlignment="Center" Margin="0,40,0,0" Visibility="Collapsed"/>
    </Grid>
</UserControl>
