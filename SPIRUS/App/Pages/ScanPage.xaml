<UserControl x:Class="Vigie.App.Pages.ScanPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <!-- Ligne de résultat (menace) -->
        <DataTemplate x:Key="ThreatTemplate">
            <Border Style="{StaticResource Row}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border x:Name="badge" Width="20" Height="22" Background="Transparent" VerticalAlignment="Top">
                        <TextBlock x:Name="glyph" Style="{StaticResource Text.Icon}" Text="&#xE7BA;" Foreground="{StaticResource Warning}" HorizontalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="1" Margin="14,0,12,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Result.ThreatName}" FontWeight="SemiBold" FontSize="14"/>
                            <Border x:Name="pill" Margin="10,0,0,0" CornerRadius="4" Padding="6,1" Background="{StaticResource WarningSoft}" VerticalAlignment="Center">
                                <TextBlock x:Name="pillText" Text="{Binding Result.VerdictLabel}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource Warning}"/>
                            </Border>
                            <TextBlock Text="{Binding Result.Category}" Style="{StaticResource Text.Muted}" FontSize="12" Margin="10,0,0,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding ScoreText}" Style="{StaticResource Text.Caption}" Margin="10,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="{Binding Result.DisplayPath}" Style="{StaticResource Text.Muted}" FontSize="12" FontFamily="{StaticResource MonoFont}" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" ToolTip="{Binding Result.DisplayPath}"/>
                        <TextBlock Text="{Binding Result.ReasonsText}" FontSize="12" Foreground="{StaticResource TextMuted}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                        <StackPanel x:Name="actions" Orientation="Horizontal">
                            <Button Style="{StaticResource Btn.Primary}" Padding="12,7" FontSize="12.5" Content="Quarantaine" Click="Quarantine_Click" Tag="{Binding}"/>
                            <Button Style="{StaticResource Btn.Secondary}" Padding="12,7" FontSize="12.5" Margin="6,0,0,0" Content="Autoriser" Click="Allow_Click" Tag="{Binding}"/>
                            <Button Style="{StaticResource Btn.Ghost}" Padding="8,7" Margin="2,0,0,0" Click="Locate_Click" Tag="{Binding}" ToolTip="Ouvrir l'emplacement">
                                <TextBlock Style="{StaticResource Text.Icon}" Text="&#xE838;" FontSize="14"/>
                            </Button>
                        </StackPanel>
                        <Border x:Name="stateBox" CornerRadius="4" Padding="8,4" Background="{StaticResource AccentSoft}" Visibility="Collapsed" HorizontalAlignment="Right">
                            <TextBlock Text="{Binding State}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Accent}" MaxWidth="260" TextWrapping="Wrap"/>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Result.Verdict}" Value="Malicious">
                    <Setter TargetName="glyph" Property="Foreground" Value="{StaticResource Danger}"/>
                    <Setter TargetName="pill" Property="Background" Value="{StaticResource DangerSoft}"/>
                    <Setter TargetName="pillText" Property="Foreground" Value="{StaticResource Danger}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Pending}" Value="False">
                    <Setter TargetName="actions" Property="Visibility" Value="Collapsed"/>
                    <Setter TargetName="stateBox" Property="Visibility" Value="Visible"/>
                    <Setter TargetName="glyph" Property="Text" Value="&#xE930;"/>
                    <Setter TargetName="glyph" Property="Foreground" Value="{StaticResource Accent}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Failed}" Value="True">
                    <Setter TargetName="actions" Property="Visibility" Value="Visible"/>
                    <Setter TargetName="stateBox" Property="Background" Value="{StaticResource DangerSoft}"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Margin="32,4,32,24">
        <!-- ============================================== Choix de l'analyse -->
        <ScrollViewer x:Name="IdlePanel" VerticalScrollBarVisibility="Auto" Focusable="False">
            <StackPanel>
                <TextBlock Text="Analyse" Style="{StaticResource Text.H1}"/>
                <TextBlock Text="Choisissez le type d'analyse, ou glissez-déposez des fichiers n'importe où dans la fenêtre." Style="{StaticResource Text.Muted}" Margin="0,2,0,18"/>
                <UniformGrid Columns="3" Margin="-6,0">
                    <Border Style="{StaticResource Card}" Margin="6" Padding="18">
                        <DockPanel>
                            <Button DockPanel.Dock="Bottom" Style="{StaticResource Btn.Primary}" Content="Lancer l'analyse rapide" Click="Quick_Click" Margin="0,18,0,0"/>
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Text.Icon}" FontSize="16" Text="&#xE945;" Foreground="{StaticResource TextMuted}"/>
                                    <TextBlock Text="Analyse rapide" Style="{StaticResource Text.H3}" Margin="10,0,0,0"/>
                                </StackPanel>
                                <TextBlock Style="{StaticResource Text.Muted}" Margin="0,6,0,0" Text="Programmes en cours, éléments de démarrage, Téléchargements, Bureau, dossiers temporaires et AppData. Idéal au quotidien."/>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <Border Style="{StaticResource Card}" Margin="6" Padding="18">
                        <DockPanel>
                            <Button DockPanel.Dock="Bottom" Style="{StaticResource Btn.Secondary}" Content="Lancer l'analyse complète" Click="Full_Click" Margin="0,18,0,0"/>
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Text.Icon}" FontSize="16" Text="&#xE7F4;" Foreground="{StaticResource TextMuted}"/>
                                    <TextBlock Text="Analyse complète" Style="{StaticResource Text.H3}" Margin="10,0,0,0"/>
                                </StackPanel>
                                <TextBlock Style="{StaticResource Text.Muted}" Margin="0,6,0,0" Text="Chaque fichier de chaque disque interne, archives comprises. Plus longue, mais rien n'y échappe."/>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <Border Style="{StaticResource Card}" Margin="6" Padding="18">
                        <DockPanel>
                            <UniformGrid DockPanel.Dock="Bottom" Columns="2" Margin="0,18,0,0">
                                <Button Style="{StaticResource Btn.Secondary}" Content="Dossier…" Click="PickFolder_Click" Margin="0,0,4,0"/>
                                <Button Style="{StaticResource Btn.Secondary}" Content="Fichiers…" Click="PickFiles_Click" Margin="4,0,0,0"/>
                            </UniformGrid>
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Text.Icon}" FontSize="16" Text="&#xE8B7;" Foreground="{StaticResource TextMuted}"/>
                                    <TextBlock Text="Analyse personnalisée" Style="{StaticResource Text.H3}" Margin="10,0,0,0"/>
                                </StackPanel>
                                <TextBlock Style="{StaticResource Text.Muted}" Margin="0,6,0,0" Text="Examinez précisément un dossier, une clé USB ou des fichiers que vous venez de recevoir."/>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                </UniformGrid>

                <Grid Margin="0,12,0,0" Height="96" AllowDrop="True">
                    <Rectangle RadiusX="8" RadiusY="8" Stroke="#3A3C42" StrokeThickness="1" StrokeDashArray="4 4" Fill="Transparent"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource Text.Icon}" Text="&#xE896;" FontSize="20" Foreground="{StaticResource TextMuted}"/>
                        <StackPanel Margin="16,0,0,0">
                            <TextBlock Text="Glissez-déposez des fichiers ou des dossiers" FontWeight="SemiBold" FontSize="14"/>
                            <TextBlock Text="SPIRUS les analyse immédiatement, y compris le contenu des archives ZIP." Style="{StaticResource Text.Muted}"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>

                <TextBlock x:Name="LastSummary" Style="{StaticResource Text.Muted}" Margin="4,16,0,0"/>
            </StackPanel>
        </ScrollViewer>

        <!-- ============================================== Analyse en cours / résultats -->
        <Grid x:Name="RunPanel" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition/>
            </Grid.RowDefinitions>

            <DockPanel>
                <Button x:Name="NewScanButton" DockPanel.Dock="Right" Style="{StaticResource Btn.Secondary}" Click="NewScan_Click" VerticalAlignment="Center" Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Text.Icon}" Text="&#xE72B;" FontSize="13" Margin="0,0,8,0"/>
                        <TextBlock Text="Nouvelle analyse"/>
                    </StackPanel>
                </Button>
                <StackPanel>
                    <TextBlock x:Name="RunTitle" Text="Analyse en cours" Style="{StaticResource Text.H1}"/>
                    <TextBlock x:Name="RunSubtitle" Style="{StaticResource Text.Muted}" FontSize="14" Margin="0,4,0,0"/>
                </StackPanel>
            </DockPanel>

            <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,16,0,12" Padding="24,20">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <Grid Width="176" Height="176">
                        <Ellipse Stroke="#2A2B30" StrokeThickness="6" Margin="3"/>
                        <Path x:Name="ProgressArc" Stroke="{StaticResource AccentGradient}" StrokeThickness="6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" RenderTransformOrigin="0.5,0.5">
                            <Path.RenderTransform><RotateTransform x:Name="ArcSpin"/></Path.RenderTransform>
                        </Path>
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock x:Name="PercentText" FontFamily="{StaticResource DisplayFont}" FontSize="32" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                            <TextBlock x:Name="PercentCaption" Style="{StaticResource Text.Caption}" HorizontalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock x:Name="DoneGlyph" Style="{StaticResource Text.Icon}" FontSize="44" HorizontalAlignment="Center" Visibility="Collapsed"/>
                    </Grid>
                    <StackPanel Grid.Column="1" Margin="32,0,0,0" VerticalAlignment="Center">
                        <TextBlock x:Name="CurrentLabel" Text="Fichier en cours" Style="{StaticResource Text.Caption}"/>
                        <TextBlock x:Name="CurrentFile" FontSize="12" FontFamily="{StaticResource MonoFont}" Foreground="{StaticResource TextMuted}" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
                        <UniformGrid Columns="4" Margin="0,20,0,0">
                            <StackPanel>
                                <TextBlock Text="Analysés" Style="{StaticResource Text.Caption}"/>
                                <TextBlock x:Name="CountScanned" Style="{StaticResource Text.Stat}"/>
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="Menaces" Style="{StaticResource Text.Caption}"/>
                                <TextBlock x:Name="CountThreats" Style="{StaticResource Text.Stat}"/>
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="Durée" Style="{StaticResource Text.Caption}"/>
                                <TextBlock x:Name="CountTime" Style="{StaticResource Text.Stat}"/>
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="Vitesse" Style="{StaticResource Text.Caption}"/>
                                <TextBlock x:Name="CountSpeed" Style="{StaticResource Text.Stat}"/>
                            </StackPanel>
                        </UniformGrid>
                        <StackPanel x:Name="RunButtons" Orientation="Horizontal" Margin="0,22,0,0">
                            <Button x:Name="PauseButton" Style="{StaticResource Btn.Secondary}" Click="Pause_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock x:Name="PauseGlyph" Style="{StaticResource Text.Icon}" Text="&#xE769;" FontSize="13" Margin="0,0,8,0"/>
                                    <TextBlock x:Name="PauseLabel" Text="Pause"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource Btn.Danger}" Click="Stop_Click" Margin="10,0,0,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Text.Icon}" Text="&#xE71A;" FontSize="13" Margin="0,0,8,0"/>
                                    <TextBlock Text="Arrêter"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                        <StackPanel x:Name="DoneButtons" Orientation="Horizontal" Margin="0,22,0,0" Visibility="Collapsed">
                            <Button x:Name="QuarantineAllButton" Style="{StaticResource Btn.Primary}" Click="QuarantineAll_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Text.Icon}" Text="&#xE72E;" FontSize="13" Margin="0,0,8,0"/>
                                    <TextBlock Text="Tout mettre en quarantaine"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="2">
                <ListBox x:Name="ThreatList" Style="{StaticResource List.Plain}" ItemTemplate="{StaticResource ThreatTemplate}"/>
                <StackPanel x:Name="CleanMessage" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,24,0,0" Visibility="Collapsed">
                    <TextBlock Text="Rien à signaler : aucun fichier dangereux n'a été trouvé." Style="{StaticResource Text.Muted}" FontSize="14" HorizontalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
