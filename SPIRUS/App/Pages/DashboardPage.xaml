<UserControl x:Class="Vigie.App.Pages.DashboardPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
        <StackPanel Margin="32,4,32,28" MaxWidth="1100">
            <TextBlock Text="Tableau de bord" Style="{StaticResource Text.H1}"/>
            <TextBlock x:Name="Greeting" Style="{StaticResource Text.Muted}" Margin="0,2,0,20"/>

            <!-- ==================================== État -->
            <Border Style="{StaticResource Card}" Padding="20,18">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Viewbox Width="44" Height="44" VerticalAlignment="Top" Margin="0,2,0,0">
                        <Canvas Width="256" Height="256">
                            <Path x:Name="ShieldPath" Fill="{StaticResource Accent}"
                                  Data="M128,12 C160,32 196,42 228,42 L228,118 C228,182 182,224 128,246 C74,224 28,182 28,118 L28,42 C60,42 96,32 128,12 Z"/>
                            <Path x:Name="ShieldMark" Stroke="{StaticResource Surface}" StrokeThickness="24" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                  Data="M78,130 L114,166 L180,96"/>
                        </Canvas>
                    </Viewbox>

                    <StackPanel Grid.Column="1" Margin="18,0,24,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="HeroTitle" FontFamily="{StaticResource DisplayFont}" FontSize="19" FontWeight="SemiBold" TextWrapping="Wrap" VerticalAlignment="Center"/>
                            <Border x:Name="StatusChip" CornerRadius="4" Padding="7,2" Margin="10,1,0,0" Background="{StaticResource AccentSoft}" VerticalAlignment="Center">
                                <TextBlock x:Name="StatusChipText" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource Accent}"/>
                            </Border>
                        </StackPanel>
                        <TextBlock x:Name="HeroSubtitle" Style="{StaticResource Text.Muted}" MaxWidth="560" HorizontalAlignment="Left" Margin="0,4,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="FixButton" Style="{StaticResource Btn.Secondary}" Click="Fix_Click" Margin="0,0,8,0" Visibility="Collapsed" Content="Tout réactiver"/>
                        <Button x:Name="FullButton" Style="{StaticResource Btn.Secondary}" Click="Full_Click" Margin="0,0,8,0" Content="Analyse complète"/>
                        <Button x:Name="QuickButton" Style="{StaticResource Btn.Primary}" Click="Quick_Click">
                            <TextBlock x:Name="QuickLabel" Text="Analyse rapide"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ==================================== Chiffres -->
            <Border Style="{StaticResource Card}" Padding="0" Margin="0,12,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="20,16">
                        <TextBlock Text="Fichiers analysés" Style="{StaticResource Text.Caption}"/>
                        <TextBlock x:Name="StatScanned" Style="{StaticResource Text.Stat}" Margin="0,4,0,0"/>
                        <TextBlock x:Name="StatScannedSub" Style="{StaticResource Text.Muted}" FontSize="12" LineHeight="17"/>
                    </StackPanel>
                    <Border Grid.Column="1" BorderBrush="{StaticResource Line}" BorderThickness="1,0,0,0">
                        <StackPanel Margin="20,16">
                            <TextBlock Text="Menaces neutralisées" Style="{StaticResource Text.Caption}"/>
                            <TextBlock x:Name="StatBlocked" Style="{StaticResource Text.Stat}" Margin="0,4,0,0"/>
                            <TextBlock x:Name="StatBlockedSub" Style="{StaticResource Text.Muted}" FontSize="12" LineHeight="17"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="2" BorderBrush="{StaticResource Line}" BorderThickness="1,0,0,0">
                        <StackPanel Margin="20,16">
                            <TextBlock Text="Dernière analyse" Style="{StaticResource Text.Caption}"/>
                            <TextBlock x:Name="StatLast" Style="{StaticResource Text.Stat}" Margin="0,4,0,0"/>
                            <TextBlock x:Name="StatLastSub" Style="{StaticResource Text.Muted}" FontSize="12" LineHeight="17"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="3" BorderBrush="{StaticResource Line}" BorderThickness="1,0,0,0">
                        <StackPanel Margin="20,16">
                            <TextBlock Text="Signatures" Style="{StaticResource Text.Caption}"/>
                            <TextBlock x:Name="StatSignatures" Style="{StaticResource Text.Stat}" Margin="0,4,0,0"/>
                            <TextBlock x:Name="StatSignaturesSub" Style="{StaticResource Text.Muted}" FontSize="12" LineHeight="17"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- ==================================== Modules et activité -->
            <Grid Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.1*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource Card}" Padding="0">
                    <StackPanel>
                        <DockPanel Margin="18,12,10,10">
                            <Button DockPanel.Dock="Right" Style="{StaticResource Btn.Ghost}" Content="Gérer" Click="Protection_Click"/>
                            <TextBlock Text="Protections" Style="{StaticResource Text.H3}" VerticalAlignment="Center"/>
                        </DockPanel>
                        <ItemsControl x:Name="Modules" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="18,10">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock x:Name="glyph" Style="{StaticResource Text.Icon}" FontSize="15" Width="18" Text="{Binding Glyph}" Foreground="{StaticResource TextMuted}"/>
                                            <StackPanel Grid.Column="1" Margin="14,0,12,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" FontSize="13"/>
                                                <TextBlock Text="{Binding Detail}" Style="{StaticResource Text.Caption}" TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Ellipse x:Name="dot" Width="6" Height="6" Fill="{StaticResource Accent}" VerticalAlignment="Center"/>
                                                <TextBlock x:Name="state" Text="Actif" FontSize="12" Foreground="{StaticResource TextMuted}" Margin="7,0,0,0"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding On}" Value="False">
                                            <Setter TargetName="dot" Property="Fill" Value="{StaticResource Warning}"/>
                                            <Setter TargetName="glyph" Property="Foreground" Value="{StaticResource Warning}"/>
                                            <Setter TargetName="state" Property="Foreground" Value="{StaticResource Warning}"/>
                                            <Setter TargetName="state" Property="Text" Value="Désactivé"/>
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource Card}" Padding="0">
                    <StackPanel>
                        <DockPanel Margin="18,12,10,10">
                            <Button DockPanel.Dock="Right" Style="{StaticResource Btn.Ghost}" Content="Journal" Click="Journal_Click"/>
                            <TextBlock Text="Activité récente" Style="{StaticResource Text.H3}" VerticalAlignment="Center"/>
                        </DockPanel>
                        <ItemsControl x:Name="Activity" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="18,10">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition/>
                                            </Grid.ColumnDefinitions>
                                            <Border x:Name="dot" Width="6" Height="6" CornerRadius="3" Background="{StaticResource TextDim}" VerticalAlignment="Top" Margin="0,7,0,0"/>
                                            <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                                <DockPanel>
                                                    <TextBlock DockPanel.Dock="Right" Text="{Binding TimeText}" Style="{StaticResource Text.Caption}" Margin="8,1,0,0"/>
                                                    <TextBlock Text="{Binding Title}" FontSize="13" TextTrimming="CharacterEllipsis"/>
                                                </DockPanel>
                                                <TextBlock Text="{Binding Detail}" Style="{StaticResource Text.Caption}" TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding Level}" Value="Success">
                                            <Setter TargetName="dot" Property="Background" Value="{StaticResource Accent}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Level}" Value="Warning">
                                            <Setter TargetName="dot" Property="Background" Value="{StaticResource Warning}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Level}" Value="Threat">
                                            <Setter TargetName="dot" Property="Background" Value="{StaticResource Danger}"/>
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Border x:Name="NoActivity" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="18,14" Visibility="Collapsed">
                            <TextBlock Text="Aucune activité pour le moment." Style="{StaticResource Text.Muted}"/>
                        </Border>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ==================================== Droits administrateur -->
            <Border x:Name="AdminBanner" Margin="0,12,0,0" CornerRadius="8" Padding="18,12" BorderBrush="{StaticResource Line}" BorderThickness="1">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource Btn.Secondary}" Click="Elevate_Click" VerticalAlignment="Center" Margin="16,0,0,0" Content="Relancer en administrateur"/>
                    <TextBlock Style="{StaticResource Text.Icon}" Text="&#xE946;" Foreground="{StaticResource TextMuted}" FontSize="15" Margin="0,0,12,0" VerticalAlignment="Top" Padding="0,2,0,0"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Mode utilisateur standard" FontSize="13"/>
                        <TextBlock Style="{StaticResource Text.Muted}" FontSize="12.5" Text="SPIRUS protège vos fichiers personnels. Pour neutraliser les menaces dans les dossiers système, relancez-le avec les droits administrateur."/>
                    </StackPanel>
                </DockPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
