<UserControl x:Class="Vigie.App.Pages.DashboardPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
        <StackPanel Margin="36,4,36,32">
            <TextBlock Text="Tableau de bord" Style="{StaticResource Text.H1}"/>
            <TextBlock x:Name="Greeting" Style="{StaticResource Text.Muted}" FontSize="14" Margin="0,4,0,22"/>

            <!-- ==================================== Bandeau principal -->
            <Border CornerRadius="22" Background="{StaticResource HeroGradient}" BorderBrush="{StaticResource Line}" BorderThickness="1" ClipToBounds="True">
                <Grid>
                    <Ellipse x:Name="HeroGlow" Width="520" Height="520" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-260,-180,0" Opacity="0.06">
                        <Ellipse.Fill>
                            <RadialGradientBrush>
                                <GradientStop x:Name="GlowStop" Color="#FFFFFF" Offset="0"/>
                                <GradientStop Color="#00FFFFFF" Offset="1"/>
                            </RadialGradientBrush>
                        </Ellipse.Fill>
                    </Ellipse>
                    <Grid Margin="34,30,34,30">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>

                        <Grid Width="200" Height="200">
                            <Ellipse x:Name="Ring1" Stroke="{StaticResource Accent}" StrokeThickness="1.5" Opacity="0" RenderTransformOrigin="0.5,0.5">
                                <Ellipse.RenderTransform><ScaleTransform/></Ellipse.RenderTransform>
                            </Ellipse>
                            <Ellipse x:Name="Ring2" Stroke="{StaticResource Accent}" StrokeThickness="1.5" Opacity="0" RenderTransformOrigin="0.5,0.5">
                                <Ellipse.RenderTransform><ScaleTransform/></Ellipse.RenderTransform>
                            </Ellipse>
                            <Ellipse x:Name="RingSpin" Width="176" Height="176" StrokeThickness="2" StrokeDashArray="2 6" Opacity="0.35" RenderTransformOrigin="0.5,0.5" Stroke="{StaticResource Accent}">
                                <Ellipse.RenderTransform><RotateTransform/></Ellipse.RenderTransform>
                            </Ellipse>
                            <Viewbox Width="118" Height="118">
                                <Canvas Width="256" Height="256">
                                    <Path x:Name="ShieldPath" Fill="{StaticResource AccentGradient}"
                                          Data="M128,12 C160,32 196,42 228,42 L228,118 C228,182 182,224 128,246 C74,224 28,182 28,118 L28,42 C60,42 96,32 128,12 Z">
                                        <Path.Effect>
                                            <DropShadowEffect x:Name="ShieldGlow" Color="#FFFFFF" BlurRadius="46" ShadowDepth="0" Opacity="0.35"/>
                                        </Path.Effect>
                                    </Path>
                                    <Path Fill="#26FFFFFF" Data="M128,12 C96,32 60,42 28,42 L28,118 C28,182 74,224 128,246 Z"/>
                                    <Path x:Name="ShieldMark" Stroke="#000000" StrokeThickness="26" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                          Data="M78,130 L114,166 L180,96"/>
                                </Canvas>
                            </Viewbox>
                        </Grid>

                        <StackPanel Grid.Column="1" Margin="34,0,0,0" VerticalAlignment="Center">
                            <Border x:Name="StatusChip" CornerRadius="20" Padding="12,5" Background="{StaticResource AccentSoft}" HorizontalAlignment="Left">
                                <TextBlock x:Name="StatusChipText" FontSize="11" FontWeight="Bold" Foreground="{StaticResource Accent}"/>
                            </Border>
                            <TextBlock x:Name="HeroTitle" FontFamily="{StaticResource DisplayFont}" FontSize="34" FontWeight="SemiBold" Margin="0,12,0,0" TextWrapping="Wrap"/>
                            <TextBlock x:Name="HeroSubtitle" Style="{StaticResource Text.Muted}" FontSize="14" MaxWidth="540" HorizontalAlignment="Left" Margin="0,6,0,0"/>
                            <WrapPanel Margin="0,22,0,0">
                                <Button x:Name="QuickButton" Style="{StaticResource Btn.Primary}" Click="Quick_Click" Margin="0,0,10,8">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource Text.Icon}" Text="&#xE721;" Margin="0,0,9,0"/>
                                        <TextBlock x:Name="QuickLabel" Text="Analyse rapide"/>
                                    </StackPanel>
                                </Button>
                                <Button x:Name="FullButton" Style="{StaticResource Btn.Secondary}" Click="Full_Click" Margin="0,0,10,8">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource Text.Icon}" Text="&#xE7F4;" Margin="0,0,9,0"/>
                                        <TextBlock Text="Analyse complète"/>
                                    </StackPanel>
                                </Button>
                                <Button x:Name="FixButton" Style="{StaticResource Btn.Secondary}" Click="Fix_Click" Margin="0,0,10,8" Visibility="Collapsed">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource Text.Icon}" Text="&#xEA18;" Margin="0,0,9,0" Foreground="{StaticResource Warning}"/>
                                        <TextBlock Text="Tout réactiver"/>
                                    </StackPanel>
                                </Button>
                            </WrapPanel>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <!-- ==================================== Statistiques -->
            <UniformGrid Columns="4" Margin="-7,16,-7,0">
                <Border Style="{StaticResource Card}" Margin="7">
                    <StackPanel>
                        <Border Style="{StaticResource IconBadge}" HorizontalAlignment="Left">
                            <TextBlock Style="{StaticResource Text.Icon}" Text="&#xE8A5;" Foreground="{StaticResource Accent}" HorizontalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Fichiers analysés" Style="{StaticResource Text.Muted}" Margin="0,14,0,0"/>
                        <TextBlock x:Name="StatScanned" FontFamily="{StaticResource DisplayFont}" FontSize="26" FontWeight="SemiBold" Margin="0,2,0,0"/>
                        <TextBlock x:Name="StatScannedSub" Style="{StaticResource Text.Muted}" FontSize="12"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="7">
                    <StackPanel>
                        <Border Style="{StaticResource IconBadge}" HorizontalAlignment="Left" >
                            <TextBlock Style="{StaticResource Text.Icon}" Text="&#xE72E;" Foreground="{StaticResource Accent}" HorizontalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Menaces neutralisées" Style="{StaticResource Text.Muted}" Margin="0,14,0,0"/>
                        <TextBlock x:Name="StatBlocked" FontFamily="{StaticResource DisplayFont}" FontSize="26" FontWeight="SemiBold" Margin="0,2,0,0"/>
                        <TextBlock x:Name="StatBlockedSub" Style="{StaticResource Text.Muted}" FontSize="12"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="7">
                    <StackPanel>
                        <Border Style="{StaticResource IconBadge}" HorizontalAlignment="Left" >
                            <TextBlock Style="{StaticResource Text.Icon}" Text="&#xE81C;" Foreground="{StaticResource Accent}" HorizontalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Dernière analyse" Style="{StaticResource Text.Muted}" Margin="0,14,0,0"/>
                        <TextBlock x:Name="StatLast" FontFamily="{StaticResource DisplayFont}" FontSize="26" FontWeight="SemiBold" Margin="0,2,0,0"/>
                        <TextBlock x:Name="StatLastSub" Style="{StaticResource Text.Muted}" FontSize="12"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="7">
                    <StackPanel>
                        <Border Style="{StaticResource IconBadge}" HorizontalAlignment="Left" >
                            <TextBlock Style="{StaticResource Text.Icon}" Text="&#xE9D9;" Foreground="{StaticResource Accent}" HorizontalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Base de signatures" Style="{StaticResource Text.Muted}" Margin="0,14,0,0"/>
                        <TextBlock x:Name="StatSignatures" FontFamily="{StaticResource DisplayFont}" FontSize="26" FontWeight="SemiBold" Margin="0,2,0,0"/>
                        <TextBlock x:Name="StatSignaturesSub" Style="{StaticResource Text.Muted}" FontSize="12"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- ==================================== Modules et activité -->
            <Grid Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.1*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Style="{StaticResource Btn.Ghost}" Content="Gérer" Click="Protection_Click"/>
                            <TextBlock Text="Modules de protection" Style="{StaticResource Text.H2}" FontSize="16" VerticalAlignment="Center"/>
                        </DockPanel>
                        <ItemsControl x:Name="Modules" Margin="0,10,0,0" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,7">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Border x:Name="badge" Width="34" Height="34" CornerRadius="9" Background="{StaticResource AccentSoft}">
                                            <TextBlock x:Name="glyph" Style="{StaticResource Text.Icon}" FontSize="15" Text="{Binding Glyph}" Foreground="{StaticResource Accent}" HorizontalAlignment="Center"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13.5"/>
                                            <TextBlock Text="{Binding Detail}" Style="{StaticResource Text.Muted}" FontSize="12" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                                        </StackPanel>
                                        <Border x:Name="pill" Grid.Column="2" CornerRadius="10" Padding="10,3" Background="{StaticResource AccentSoft}" VerticalAlignment="Center">
                                            <TextBlock x:Name="state" Text="Actif" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource Accent}"/>
                                        </Border>
                                    </Grid>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding On}" Value="False">
                                            <Setter TargetName="badge" Property="Background" Value="{StaticResource WarningSoft}"/>
                                            <Setter TargetName="glyph" Property="Foreground" Value="{StaticResource Warning}"/>
                                            <Setter TargetName="pill" Property="Background" Value="{StaticResource WarningSoft}"/>
                                            <Setter TargetName="state" Property="Foreground" Value="{StaticResource Warning}"/>
                                            <Setter TargetName="state" Property="Text" Value="Désactivé"/>
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource Card}">
                    <StackPanel>
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Style="{StaticResource Btn.Ghost}" Content="Tout voir" Click="Journal_Click"/>
                            <TextBlock Text="Activité récente" Style="{StaticResource Text.H2}" FontSize="16" VerticalAlignment="Center"/>
                        </DockPanel>
                        <ItemsControl x:Name="Activity" Margin="0,10,0,0" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,7">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition/>
                                        </Grid.ColumnDefinitions>
                                        <Border x:Name="dot" Width="8" Height="8" CornerRadius="4" Background="{StaticResource Info}" VerticalAlignment="Top" Margin="2,6,0,0"/>
                                        <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                            <DockPanel>
                                                <TextBlock DockPanel.Dock="Right" Text="{Binding TimeText}" Style="{StaticResource Text.Caption}" FontWeight="Normal" Margin="8,2,0,0"/>
                                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis"/>
                                            </DockPanel>
                                            <TextBlock Text="{Binding Detail}" Style="{StaticResource Text.Muted}" FontSize="12" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                                        </StackPanel>
                                    </Grid>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding Level}" Value="Success">
                                            <Setter TargetName="dot" Property="Background" Value="{StaticResource Accent}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Level}" Value="Warning">
                                            <Setter TargetName="dot" Property="Background" Value="{StaticResource Warning}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Level}" Value="Threat">
                                            <Setter TargetName="dot" Property="Background" Value="{StaticResource Danger}"/>
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock x:Name="NoActivity" Text="Aucune activité pour le moment." Style="{StaticResource Text.Muted}" Margin="0,8,0,0" Visibility="Collapsed"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ==================================== Droits administrateur -->
            <Border x:Name="AdminBanner" Margin="0,16,0,0" CornerRadius="14" Background="{StaticResource Surface}" Padding="18,14" BorderBrush="#262626" BorderThickness="1">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource Btn.Secondary}" Click="Elevate_Click" VerticalAlignment="Center" Margin="12,0,0,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Text.Icon}" Text="&#xE7EF;" Margin="0,0,8,0" FontSize="14"/>
                            <TextBlock Text="Relancer en administrateur"/>
                        </StackPanel>
                    </Button>
                    <TextBlock Style="{StaticResource Text.Icon}" Text="&#xE946;" Foreground="{StaticResource TextMuted}" FontSize="18" Margin="0,0,14,0"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Mode utilisateur standard" FontWeight="SemiBold" FontSize="13.5"/>
                        <TextBlock Style="{StaticResource Text.Muted}" FontSize="12.5" Text="SPIRUS protège vos fichiers personnels. Pour neutraliser les menaces cachées dans les dossiers système, relancez-le avec les droits administrateur."/>
                    </StackPanel>
                </DockPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
