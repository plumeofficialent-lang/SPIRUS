<UserControl x:Class="Vigie.App.Pages.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto" Focusable="False">
        <StackPanel Margin="36,4,36,32">
            <TextBlock Text="Paramètres" Style="{StaticResource Text.H1}"/>
            <TextBlock Text="Démarrage, analyses planifiées, signatures et exclusions." Style="{StaticResource Text.Muted}" FontSize="14" Margin="0,4,0,0"/>
            <StackPanel x:Name="Rows"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
