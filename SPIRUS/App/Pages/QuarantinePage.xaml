<UserControl x:Class="Vigie.App.Pages.QuarantinePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="36,4,36,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <DockPanel Margin="0,0,0,20">
            <Button x:Name="DeleteAllButton" DockPanel.Dock="Right" Style="{StaticResource Btn.Danger}" VerticalAlignment="Center" Click="DeleteAll_Click">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource Text.Icon}" Text="&#xE74D;" FontSize="13" Margin="0,0,8,0"/>
                    <TextBlock Text="Tout supprimer définitivement"/>
                </StackPanel>
            </Button>
            <StackPanel>
                <TextBlock Text="Quarantaine" Style="{StaticResource Text.H1}"/>
                <TextBlock x:Name="Subtitle" Style="{StaticResource Text.Muted}" FontSize="14" Margin="0,4,0,0"/>
            </StackPanel>
        </DockPanel>

        <ListBox x:Name="Items" Grid.Row="1" Style="{StaticResource List.Plain}">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource Row}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Width="40" Height="40" CornerRadius="11" Background="{StaticResource DangerSoft}" VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource Text.Icon}" Text="&#xE72E;" Foreground="{StaticResource Danger}" HorizontalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" Margin="16,0,12,0" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding FileName}" FontWeight="SemiBold" FontSize="14"/>
                                    <Border Margin="10,0,0,0" CornerRadius="8" Padding="8,1" Background="{StaticResource DangerSoft}" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding ThreatName}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource Danger}"/>
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="{Binding OriginalPath}" Style="{StaticResource Text.Muted}" FontSize="12" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" ToolTip="{Binding OriginalPath}"/>
                                <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                    <TextBlock Text="{Binding DateText}" Style="{StaticResource Text.Caption}" FontWeight="Normal"/>
                                    <TextBlock Text="  •  " Style="{StaticResource Text.Caption}"/>
                                    <TextBlock Text="{Binding SizeText}" Style="{StaticResource Text.Caption}" FontWeight="Normal"/>
                                    <TextBlock Text="  •  " Style="{StaticResource Text.Caption}"/>
                                    <TextBlock Text="{Binding Category}" Style="{StaticResource Text.Caption}" FontWeight="Normal"/>
                                </StackPanel>
                            </StackPanel>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Style="{StaticResource Btn.Secondary}" Padding="12,7" FontSize="12.5" Content="Restaurer" Click="Restore_Click" Tag="{Binding}"/>
                                <Button Style="{StaticResource Btn.Danger}" Padding="12,7" FontSize="12.5" Margin="8,0,0,0" Content="Supprimer" Click="Delete_Click" Tag="{Binding}"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <StackPanel x:Name="Empty" Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,0,0,60">
            <Border Width="96" Height="96" CornerRadius="48" Background="{StaticResource AccentSoft}" HorizontalAlignment="Center">
                <TextBlock Style="{StaticResource Text.Icon}" Text="&#xEA18;" FontSize="40" Foreground="{StaticResource Accent}" HorizontalAlignment="Center"/>
            </Border>
            <TextBlock Text="La quarantaine est vide" Style="{StaticResource Text.H2}" HorizontalAlignment="Center" Margin="0,20,0,0"/>
            <TextBlock Text="Les fichiers dangereux neutralisés par SPIRUS apparaîtront ici, chiffrés et inoffensifs." Style="{StaticResource Text.Muted}" FontSize="14" HorizontalAlignment="Center" Margin="0,6,0,0"/>
        </StackPanel>
    </Grid>
</UserControl>
