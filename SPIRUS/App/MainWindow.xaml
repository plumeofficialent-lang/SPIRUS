<Window x:Class="Vigie.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SPIRUS Antivirus" Width="1200" Height="780" MinWidth="1000" MinHeight="660"
        WindowStartupLocation="CenterScreen" Background="{StaticResource Bg}" Foreground="{StaticResource Text}"
        FontFamily="{StaticResource UiFont}" Icon="Assets/vigie.ico" AllowDrop="True"
        TextOptions.TextFormattingMode="Ideal" UseLayoutRounding="True">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Grid x:Name="RootGrid">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="248"/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>

        <!-- ======================================== Barre latérale -->
        <Border Background="{StaticResource Sidebar}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="26,28,20,30">
                    <Image Source="Assets/vigie.png" Width="36" Height="36" RenderOptions.BitmapScalingMode="HighQuality">
                        <Image.Effect>
                            <DropShadowEffect Color="#FFFFFF" BlurRadius="16" ShadowDepth="0" Opacity="0.18"/>
                        </Image.Effect>
                    </Image>
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="SPIRUS" FontFamily="{StaticResource DisplayFont}" FontSize="22" FontWeight="Bold"/>
                        <TextBlock Text="A N T I V I R U S" FontSize="9.5" FontWeight="SemiBold" Foreground="{StaticResource TextDim}" Margin="1,-1,0,0"/>
                    </StackPanel>
                </StackPanel>

                <Border DockPanel.Dock="Bottom" Margin="16,0,16,18" Padding="14,12" CornerRadius="12" Background="#0A0A0A"
                        BorderBrush="{StaticResource Line}" BorderThickness="1">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Grid Width="12" Height="12" VerticalAlignment="Center">
                                <Ellipse x:Name="StatusPulse" Fill="{StaticResource Accent}" RenderTransformOrigin="0.5,0.5" Opacity="0.5">
                                    <Ellipse.RenderTransform><ScaleTransform/></Ellipse.RenderTransform>
                                </Ellipse>
                                <Ellipse x:Name="StatusDot" Width="8" Height="8" Fill="{StaticResource Accent}"/>
                            </Grid>
                            <TextBlock x:Name="SideStatus" Text="Protection active" Margin="10,0,0,0" FontWeight="SemiBold" FontSize="13"/>
                        </StackPanel>
                        <TextBlock x:Name="SideDetail" Style="{StaticResource Text.Muted}" FontSize="11.5" Margin="22,3,0,0"/>
                    </StackPanel>
                </Border>

                <StackPanel>
                    <TextBlock Text="MENU" Style="{StaticResource Text.Caption}" Margin="30,0,0,8"/>
                    <RadioButton x:Name="NavDashboard" Style="{StaticResource Nav}" Tag="&#xE80F;" Content="Tableau de bord" IsChecked="True" Checked="Nav_Checked"/>
                    <RadioButton x:Name="NavScan" Style="{StaticResource Nav}" Tag="&#xE721;" Content="Analyse" Checked="Nav_Checked"/>
                    <RadioButton x:Name="NavProtection" Style="{StaticResource Nav}" Tag="&#xEA18;" Content="Protection" Checked="Nav_Checked"/>
                    <RadioButton x:Name="NavQuarantine" Style="{StaticResource Nav}" Tag="&#xE72E;" Checked="Nav_Checked">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Quarantaine"/>
                            <Border x:Name="QuarantineBadge" Margin="10,0,0,0" CornerRadius="9" MinWidth="20" Height="18" Padding="6,0" Background="{StaticResource DangerSoft}" Visibility="Collapsed">
                                <TextBlock x:Name="QuarantineCount" FontSize="11" FontWeight="Bold" Foreground="{StaticResource Danger}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="NavJournal" Style="{StaticResource Nav}" Tag="&#xE81C;" Content="Journal" Checked="Nav_Checked"/>
                    <RadioButton x:Name="NavSettings" Style="{StaticResource Nav}" Tag="&#xE713;" Content="Paramètres" Checked="Nav_Checked"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ======================================== Contenu -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition/>
            </Grid.RowDefinitions>

            <TextBlock x:Name="ModeLabel" Margin="36,0,0,0" VerticalAlignment="Center" Style="{StaticResource Text.Caption}"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" WindowChrome.IsHitTestVisibleInChrome="True">
                <Button Style="{StaticResource Btn.Chrome}" Content="&#xE921;" Click="Minimize_Click" ToolTip="Réduire"/>
                <Button x:Name="MaxButton" Style="{StaticResource Btn.Chrome}" Content="&#xE922;" Click="Maximize_Click" ToolTip="Agrandir"/>
                <Button Style="{StaticResource Btn.Close}" Content="&#xE8BB;" Click="Close_Click" ToolTip="Fermer (SPIRUS reste actif en arrière-plan)"/>
            </StackPanel>

            <ContentControl x:Name="PageHost" Grid.Row="1" Focusable="False"/>

            <Border x:Name="DropOverlay" Grid.RowSpan="2" Background="#EB000000" Visibility="Collapsed" IsHitTestVisible="False">
                <Border Margin="40" CornerRadius="24" BorderThickness="2" BorderBrush="{StaticResource Accent}">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Style="{StaticResource Text.Icon}" FontSize="56" Text="&#xE896;" Foreground="{StaticResource Accent}" HorizontalAlignment="Center"/>
                        <TextBlock Text="Déposez pour analyser" Style="{StaticResource Text.H1}" Margin="0,18,0,0" HorizontalAlignment="Center"/>
                        <TextBlock Text="Fichiers, dossiers ou archives : SPIRUS les examine immédiatement." Style="{StaticResource Text.Muted}" FontSize="14" Margin="0,6,0,0" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Border>
        </Grid>
    </Grid>
</Window>
