<Window x:Class="Vigie.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SPIRUS Antivirus" Width="1200" Height="780" MinWidth="1000" MinHeight="660"
        WindowStartupLocation="CenterScreen" Background="{StaticResource Bg}" Foreground="{StaticResource Text}"
        FontFamily="{StaticResource UiFont}" Icon="Assets/vigie.ico" AllowDrop="True"
        TextOptions.TextFormattingMode="Ideal" UseLayoutRounding="True">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Grid x:Name="RootGrid">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>

        <!-- ======================================== Barre latérale -->
        <Border Background="{StaticResource Sidebar}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="22,18,20,22">
                    <Image Source="Assets/vigie.png" Width="22" Height="22" RenderOptions.BitmapScalingMode="HighQuality"/>
                    <TextBlock Text="SPIRUS" FontFamily="{StaticResource DisplayFont}" FontSize="15" FontWeight="SemiBold" Margin="10,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>

                <Border DockPanel.Dock="Bottom" Margin="10,0,10,12" Padding="12,10" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="StatusDot" Width="7" Height="7" Fill="{StaticResource Accent}" VerticalAlignment="Center"/>
                            <TextBlock x:Name="SideStatus" Text="Protection active" Margin="9,0,0,0" FontSize="12.5"/>
                        </StackPanel>
                        <TextBlock x:Name="SideDetail" Style="{StaticResource Text.Caption}" Margin="16,2,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <StackPanel>
                    <RadioButton x:Name="NavDashboard" Style="{StaticResource Nav}" Tag="&#xE80F;" Content="Tableau de bord" IsChecked="True" Checked="Nav_Checked"/>
                    <RadioButton x:Name="NavScan" Style="{StaticResource Nav}" Tag="&#xE721;" Content="Analyse" Checked="Nav_Checked"/>
                    <RadioButton x:Name="NavProtection" Style="{StaticResource Nav}" Tag="&#xEA18;" Content="Protection" Checked="Nav_Checked"/>
                    <RadioButton x:Name="NavQuarantine" Style="{StaticResource Nav}" Tag="&#xE72E;" Checked="Nav_Checked">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Quarantaine"/>
                            <Border x:Name="QuarantineBadge" Margin="8,0,0,0" CornerRadius="4" MinWidth="18" Height="17" Padding="5,0" Background="{StaticResource Danger}" Visibility="Collapsed">
                                <TextBlock x:Name="QuarantineCount" FontSize="10.5" FontWeight="SemiBold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="NavJournal" Style="{StaticResource Nav}" Tag="&#xE81C;" Content="Journal" Checked="Nav_Checked"/>
                    <RadioButton x:Name="NavSettings" Style="{StaticResource Nav}" Tag="&#xE713;" Content="Paramètres" Checked="Nav_Checked"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ======================================== Contenu -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition/>
            </Grid.RowDefinitions>

            <TextBlock x:Name="ModeLabel" Margin="32,0,0,0" VerticalAlignment="Center" Style="{StaticResource Text.Caption}"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" WindowChrome.IsHitTestVisibleInChrome="True">
                <Button Style="{StaticResource Btn.Chrome}" Content="&#xE921;" Click="Minimize_Click" ToolTip="Réduire"/>
                <Button x:Name="MaxButton" Style="{StaticResource Btn.Chrome}" Content="&#xE922;" Click="Maximize_Click" ToolTip="Agrandir"/>
                <Button Style="{StaticResource Btn.Close}" Content="&#xE8BB;" Click="Close_Click" ToolTip="Fermer (SPIRUS reste actif en arrière-plan)"/>
            </StackPanel>

            <ContentControl x:Name="PageHost" Grid.Row="1" Focusable="False"/>

            <Border x:Name="DropOverlay" Grid.RowSpan="2" Background="#E6141517" Visibility="Collapsed" IsHitTestVisible="False">
                <Border Margin="32" CornerRadius="8" BorderThickness="1.5" BorderBrush="{StaticResource TextMuted}">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Style="{StaticResource Text.Icon}" FontSize="32" Text="&#xE896;" Foreground="{StaticResource Text}" HorizontalAlignment="Center"/>
                        <TextBlock Text="Déposez pour analyser" Style="{StaticResource Text.H2}" FontSize="18" Margin="0,14,0,0" HorizontalAlignment="Center"/>
                        <TextBlock Text="Fichiers, dossiers ou archives : SPIRUS les examine immédiatement." Style="{StaticResource Text.Muted}" FontSize="14" Margin="0,6,0,0" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Border>
        </Grid>
    </Grid>
</Window>
